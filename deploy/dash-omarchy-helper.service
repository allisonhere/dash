[Unit]
Description=Dash local Omarchy theme helper
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/dash
EnvironmentFile=-%h/.config/dash/omarchy-helper.env
ExecStart=/usr/bin/env npm run omarchy:helper
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
